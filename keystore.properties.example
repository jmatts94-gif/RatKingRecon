# Template for keystore.properties. Copy to keystore.properties and fill in.
#
#   copy keystore.properties.example keystore.properties
#
# The real file is gitignored, and must stay that way: it holds the signing
# password in plain text. So is the .jks it points at.
#
# Losing the keystore is not recoverable. Play identifies an app by the key that
# signed it, so an update signed by a different key is refused - the only way
# forward would be a new listing under a new applicationId, abandoning every
# install and review. Back the .jks up somewhere that is not this machine, and
# keep the password somewhere that is not next to it.
#
# Generate the keystore with (run this yourself, so the password is never typed
# into a terminal transcript or a shell history file):
#
#   keytool -genkeypair -v \
#     -keystore ratkingrecon-release.jks \
#     -alias ratkingrecon \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# keytool prompts for the password and the certificate details. Twenty-seven
# years of validity is deliberate: Play requires a key valid well past 2033, and
# a key that expires is a key that cannot ship an update.

# Path to the .jks, relative to the project root.
storeFile=ratkingrecon-release.jks

# The password given to -keystore when it was created.
storePassword=CHANGE_ME

# The -alias the key was created under.
keyAlias=ratkingrecon

# The key's own password. keytool offers to reuse the store password; if it was
# reused, put the same value here.
keyPassword=CHANGE_ME
