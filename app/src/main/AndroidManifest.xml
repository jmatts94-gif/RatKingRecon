<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- AdMob (rewarded ads) and Play Billing (the Supporter Pack) both need
         a live connection to the Play/Google ad-serving backends. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Background step tracking, so a hatch can be announced while the app is closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:name=".RatKingApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RatKingRecon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SplicingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".TaskRatPickerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ArenaLandingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RatKingRecon.Arena" />
        <activity
            android:name=".ArenaSelectActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ArenaPrepActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RatKingRecon.Arena" />
        <activity
            android:name=".TasksActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- Wakes when a Ledger Task finishes; internal only. -->
        <receiver
            android:name=".LedgerTaskAlarmReceiver"
            android:exported="false" />

        <!-- Wakes in the evening to check the streak; internal only. -->
        <receiver
            android:name=".StreakReminderReceiver"
            android:exported="false" />

        <activity
            android:name=".ShopActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".RelicTraderActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".GearWorkshopActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".AchievementsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".FactionCodexActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".BattleActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <!-- Auto-Resolve from the notification; internal only. -->
        <receiver
            android:name=".EncounterActionReceiver"
            android:exported="false" />

        <!--
          Resumes tracking after a reboot or an app update. Both broadcasts are
          exempt from the background foreground-service restriction; exported
          must stay true because they are delivered by the system.
        -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".StepTrackerService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Hands a Recon Card image to the OS share sheet - see ReconCard.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Google's own published test App ID - safe to ship in a build that
          only ever requests test ad units (see RewardedAds.AD_UNIT_ID's own
          comment). Swap for the real one from AdMob once that account exists;
          until then this is the only App ID that will serve anything at all.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>

</manifest>