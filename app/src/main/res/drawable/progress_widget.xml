<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's own bar. The empty track is an outline rather than a fill,
  because the home screen can show the dark palette, where the app's usual
  track colour sits too close to the card to see.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/text_muted" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/highlight_glow" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>
</layer-list>
