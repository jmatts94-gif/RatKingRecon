<?xml version="1.0" encoding="utf-8"?>
<!--
  Small rounded chip used by the header stats (level / steps / scrap), and by
  the same kind of count elsewhere.

  The fill is a very shallow top-to-bottom gradient rather than flat white:
  lighter at the top, a touch of warmth at the bottom, which is what reads as a
  surface catching light from above. Both ends stay inside the cream palette -
  the difference is a few percent, and it is meant to be felt rather than seen.

  The drop shadow is not here. A shape has no shadow of its own; it comes from
  elevation on the view wearing this, whose outline Android takes from these
  corners.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/card_white"
        android:endColor="#F8F0E1"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/card_border" />
    <corners android:radius="20dp" />
</shape>
