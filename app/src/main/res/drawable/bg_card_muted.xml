<?xml version="1.0" encoding="utf-8"?>
<!--
  Recessed version of bg_card_white, for a panel that is on screen but has
  nothing in it yet. Same corner radius and border as a real card, so an empty
  section still reads as part of the same set.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/disabled_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/card_border" />
    <corners android:radius="16dp" />
</shape>
