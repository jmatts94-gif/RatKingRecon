<?xml version="1.0" encoding="utf-8"?>
<!--
  The Arena home-tile's own pill, sized and shaped like bg_pill_tan so the two
  tiles in that row still read as a matched pair - the palette is still the
  Arena's own, but shadow_warm rather than arena_bg_deep: that colour is
  already doing surface duty on the Arena's own screens (see bg_card_arena),
  and it is lighter - bronze and silver medallions read clearly against it,
  where arena_bg_deep left everything but the gold one hard to pick out.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#5C3D14"
        android:endColor="@color/shadow_warm"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/copper" />
    <corners android:radius="20dp" />
</shape>
