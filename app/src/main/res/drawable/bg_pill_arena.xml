<?xml version="1.0" encoding="utf-8"?>
<!--
  The Arena home-tile's own pill.

  Two darker attempts (arena_bg_deep, then shadow_warm) both left at least
  one medallion hard to pick out - the badges are copper, pewter and
  brass_bright, three medium-saturation metal tones, and there is no dark
  fill that reads as clearly distinct from all three at once. This uses
  bg_pill_tan's own light cream gradient instead - what every other tile on
  this screen already sits on, and metal reads against cream at a glance.

  The rim is bg_pill_tan's own brass-pipe ring, verbatim - see that
  drawable's own comment for why it is five stroke-only layers rather than
  one. Kept identical rather than reusing this tile's old single copper
  stroke, so every tile on the home screen is trimmed the same way; the
  fill and the badges on top are still what mark this one as the Arena's.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/card_white"
                android:endColor="#F8F0E1"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3.4dp" android:color="@color/shadow_warm" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2.6dp" android:color="@color/copper_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.8dp" android:color="@color/copper" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.9dp" android:color="@color/brass_bright" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="@color/cream" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
