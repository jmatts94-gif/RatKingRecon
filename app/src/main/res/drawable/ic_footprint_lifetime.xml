<?xml version="1.0" encoding="utf-8"?>
<!--
  The footprint, with the walk it came from trailing behind it.

  The header pill counts every step ever taken and the tile beside the egg counts
  today's. Both are steps, so both want the footprint - but drawn identically they
  say the same thing twice, and the difference between the two numbers is the
  whole point of showing them together.

  So this is ic_footprint pulled back to make room, with two marks receding
  behind it. Deliberately small and deliberately not a clock or an infinity sign:
  the distinction being drawn is "further back", not "forever", and a second
  symbol competing with the footprint would read as a different idea rather than
  as more of the same one.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="@color/text_primary">

    <!-- The walk so far, receding. -->
    <path
        android:fillColor="@color/text_primary"
        android:pathData="M150,745 a58,58 0 1,0 116,0 a58,58 0 1,0 -116,0" />
    <path
        android:fillColor="@color/text_primary"
        android:pathData="M40,880 a38,38 0 1,0 76,0 a38,38 0 1,0 -76,0" />

    <!-- ic_footprint, scaled back and lifted clear of the trail. -->
    <group
        android:pivotX="480"
        android:pivotY="480"
        android:scaleX="0.78"
        android:scaleY="0.78"
        android:translateX="95"
        android:translateY="-70">
        <group android:translateX="-0" android:translateY="960">
            <path
                android:fillColor="@color/text_primary"
                android:pathData="M315-240q-77 0-117-57t-38-128l-18-27q-11-17-36.5-77T80-680q0-103 51-171.5T260-920q85 0 132.5 75.5T440-680q0 58-16 107t-28 79l8 13q8 14 22 44.5t14 63.5q0 57-35.5 95T315-240ZM210-496l110-22q13-32 26.5-73t13.5-89q0-60-27.5-110T260-840q-45 0-72.5 50T160-680q0 63 17.5 111.5T210-496Zm105 176q19 0 32-14t13-39q0-17-8-35t-16-32l-96 20q0 40 17.5 70t57.5 30ZM645-40q-54 0-89.5-38T520-173q0-33 14-63.5t22-44.5l8-13q-12-30-28-79t-16-107q0-89 47.5-164.5T700-720q78 0 129 68.5T880-480q0 91-25.5 150.5T818-253l-18 28q1 71-38.5 128T645-40Zm105-256q15-24 32.5-72T800-480q0-60-27.5-110T700-640q-45 0-72.5 50T600-480q0 48 13.5 88.5T640-318l110 22ZM645-120q40 0 57.5-30t17.5-70l-96-20q-8 14-16 32t-8 35q0 20 12.5 36.5T645-120Z" />
        </group>
    </group>
</vector>
