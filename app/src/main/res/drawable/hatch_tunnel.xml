<!--
  The pipe the rat travels down as EXP banks toward the next hatch, replacing
  the five-stage cracked egg. A full rewrite rather than another patch on the
  version before it - several rounds of end-cap and joint tweaks had piled up
  into something worth rebuilding clean rather than untangling further.

  One centreline, stroked five times at shrinking width for a lit-cylinder
  look: dark bronze rim, a darker copper core shadow, the copper body
  itself, a broad soft brass sheen, then a narrow near-white specular line.
  strokeLineJoin is round rather than miter - a mitred corner is what turned
  the bends into a sharp zigzag in an earlier version; a round join is what
  an actual pipe elbow looks like, and it needs no separate decoration at
  the bend to read that way. strokeLineCap is butt, so the main centreline
  stroke itself stops flush at the pipe's own width - the end pieces below
  are drawn as their own short stub-and-lip past that flush end, not as a
  cap baked into this stroke, which is what kept three earlier passes
  (a round medallion, an oval collar, a flat rectangular lip drawn directly
  on the stroke's own rounded cap) fighting the pipe's own geometry instead
  of sitting cleanly past it.

  Small rivets still run along every seam - the one piece of prior detailing
  this rewrite keeps, since nothing here asked for it to go.

  The centreline's points (the M/L commands below) are duplicated exactly in
  MainActivity.kt's tunnelPath - the same path drives where the rat icon
  sits, so the two can never drift out of alignment. Change one, change the
  other. Purely a rendering change either way: PathMeasure walks arc length
  along the Path object itself, never the stroke drawn from it, so how the
  pipe's corners are joined or its ends are capped cannot move the rat off
  the centreline it always followed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="220dp"
    android:height="220dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Outer rim: the pipe's own shadow, giving the stack below it depth. -->
    <path
        android:pathData="M85,12 L15,12 L15,30 L85,30 L85,48 L15,48 L15,66 L85,66 L85,84 L15,84"
        android:fillColor="#00000000"
        android:strokeColor="@color/shadow_warm"
        android:strokeWidth="9"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round" />

    <!-- Core shadow: one more step between the rim and the lit body. -->
    <path
        android:pathData="M85,12 L15,12 L15,30 L85,30 L85,48 L15,48 L15,66 L85,66 L85,84 L15,84"
        android:fillColor="#00000000"
        android:strokeColor="@color/copper_shadow"
        android:strokeWidth="7"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round" />

    <!-- Pipe body. -->
    <path
        android:pathData="M85,12 L15,12 L15,30 L85,30 L85,48 L15,48 L15,66 L85,66 L85,84 L15,84"
        android:fillColor="#00000000"
        android:strokeColor="@color/copper"
        android:strokeWidth="5.5"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round" />

    <!-- Sheen: a broad soft highlight along the top of the pipe. -->
    <path
        android:pathData="M85,12 L15,12 L15,30 L85,30 L85,48 L15,48 L15,66 L85,66 L85,84 L15,84"
        android:fillColor="#00000000"
        android:strokeColor="@color/brass_bright"
        android:strokeAlpha="0.65"
        android:strokeWidth="2.6"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round" />

    <!-- Specular: a narrow, near-opaque chrome glint, thinner and brighter
         than the sheen above so the two read as distinct effects. -->
    <path
        android:pathData="M85,12 L15,12 L15,30 L85,30 L85,48 L15,48 L15,66 L85,66 L85,84 L15,84"
        android:fillColor="#00000000"
        android:strokeColor="@color/cream"
        android:strokeAlpha="0.95"
        android:strokeWidth="0.55"
        android:strokeLineCap="butt"
        android:strokeLineJoin="round" />

    <!-- Rivets along each seam, three per run. -->
    <path android:pathData="M31.3,12 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M51.3,12 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M71.3,12 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M31.3,30 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M51.3,30 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M71.3,30 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M31.3,48 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M51.3,48 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M71.3,48 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M31.3,66 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M51.3,66 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M71.3,66 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M31.3,84 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M51.3,84 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />
    <path android:pathData="M71.3,84 a1.3,1.3 0 1,0 -2.6,0 a1.3,1.3 0 1,0 2.6,0"
        android:fillColor="@color/amber_dark" android:strokeColor="@color/shadow_warm" android:strokeWidth="0.4" />

    <!--
      The entrance (top right): a short stub continuing straight past the
      pipe's own flush end, then a lip. Same five-layer stroke the main pipe
      uses, so the stub reads as more of the same pipe rather than a new
      piece.
    -->
    <path android:pathData="M85,12 L93,12" android:fillColor="#00000000" android:strokeColor="@color/shadow_warm" android:strokeWidth="9" android:strokeLineCap="butt" />
    <path android:pathData="M85,12 L93,12" android:fillColor="#00000000" android:strokeColor="@color/copper_shadow" android:strokeWidth="7" android:strokeLineCap="butt" />
    <path android:pathData="M85,12 L93,12" android:fillColor="#00000000" android:strokeColor="@color/copper" android:strokeWidth="5.5" android:strokeLineCap="butt" />
    <path android:pathData="M85,12 L93,12" android:fillColor="#00000000" android:strokeColor="@color/brass_bright" android:strokeAlpha="0.65" android:strokeWidth="2.6" android:strokeLineCap="butt" />
    <path android:pathData="M85,12 L93,12" android:fillColor="#00000000" android:strokeColor="@color/cream" android:strokeAlpha="0.95" android:strokeWidth="0.55" android:strokeLineCap="butt" />

    <!--
      The lip: a flat rectangular band, straight-edged throughout - no curve
      anywhere in it. Runs vertically since the stub it sits on runs
      horizontally, and it is taller (15) than the pipe itself is wide (9)
      so it overhangs visibly on both sides. Shaded in flat bands rather than
      blended - a dark base rectangle, a lit copper rectangle inset inside
      it, a brass strip along the top edge only and a darker strip along the
      bottom edge only - so it reads as lit from above and as its own flat
      plate rather than the pipe's own gradient continuing through it.
    -->
    <path android:pathData="M90.5,4.5 L95.5,4.5 L95.5,19.5 L90.5,19.5 Z" android:fillColor="@color/shadow_warm" />
    <path android:pathData="M91,5 L95,5 L95,19 L91,19 Z" android:fillColor="@color/copper" />
    <path android:pathData="M91,5 L95,5 L95,7 L91,7 Z" android:fillColor="@color/brass_bright" android:fillAlpha="0.85" />
    <path android:pathData="M91,17 L95,17 L95,19 L91,19 Z" android:fillColor="@color/copper_shadow" android:fillAlpha="0.6" />
    <path android:pathData="M92.2,12 a0.7,0.7 0 1,0 -1.4,0 a0.7,0.7 0 1,0 1.4,0" android:fillColor="@color/amber_dark" />
    <path android:pathData="M95.2,12 a0.7,0.7 0 1,0 -1.4,0 a0.7,0.7 0 1,0 1.4,0" android:fillColor="@color/amber_dark" />

    <!-- The hatch (bottom left): the same stub-and-lip, continuing left. -->
    <path android:pathData="M15,84 L7,84" android:fillColor="#00000000" android:strokeColor="@color/shadow_warm" android:strokeWidth="9" android:strokeLineCap="butt" />
    <path android:pathData="M15,84 L7,84" android:fillColor="#00000000" android:strokeColor="@color/copper_shadow" android:strokeWidth="7" android:strokeLineCap="butt" />
    <path android:pathData="M15,84 L7,84" android:fillColor="#00000000" android:strokeColor="@color/copper" android:strokeWidth="5.5" android:strokeLineCap="butt" />
    <path android:pathData="M15,84 L7,84" android:fillColor="#00000000" android:strokeColor="@color/brass_bright" android:strokeAlpha="0.65" android:strokeWidth="2.6" android:strokeLineCap="butt" />
    <path android:pathData="M15,84 L7,84" android:fillColor="#00000000" android:strokeColor="@color/cream" android:strokeAlpha="0.95" android:strokeWidth="0.55" android:strokeLineCap="butt" />

    <path android:pathData="M4.5,76.5 L9.5,76.5 L9.5,91.5 L4.5,91.5 Z" android:fillColor="@color/shadow_warm" />
    <path android:pathData="M5,77 L9,77 L9,91 L5,91 Z" android:fillColor="@color/copper" />
    <path android:pathData="M5,77 L9,77 L9,79 L5,79 Z" android:fillColor="@color/brass_bright" android:fillAlpha="0.85" />
    <path android:pathData="M5,89 L9,89 L9,91 L5,91 Z" android:fillColor="@color/copper_shadow" android:fillAlpha="0.6" />
    <path android:pathData="M6.2,84 a0.7,0.7 0 1,0 -1.4,0 a0.7,0.7 0 1,0 1.4,0" android:fillColor="@color/amber_dark" />
    <path android:pathData="M9.2,84 a0.7,0.7 0 1,0 -1.4,0 a0.7,0.7 0 1,0 1.4,0" android:fillColor="@color/amber_dark" />
</vector>
