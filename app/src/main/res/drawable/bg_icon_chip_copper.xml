<?xml version="1.0" encoding="utf-8"?>
<!--
  See bg_icon_chip_amber.xml's own comment - the same idea, copper instead
  of amber_dark, behind the steps tile's icon so the two tiles read as two
  different colours rather than one repeated chip. Needs the same
  android:tint="@color/cream" on the icon drawn over it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/copper" />
</shape>
