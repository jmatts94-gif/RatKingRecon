<?xml version="1.0" encoding="utf-8"?>
<!--
  The battle screen's Rustbot portrait. No Rustbot has ever had art of its own
  the way a rat has RatArt/imageRes - every encounter drew the exact same
  vector glyph rather than a per-bot illustration, so this stays generic
  (a boxy head, one lens, a single antenna) instead of trying to read as any
  specific Rustbot.

  Built the same way ic_rat_silhouette.xml is - a glow halo plus a flat
  silhouette - so the two portraits read as one visual family sitting across
  from each other. The halo swaps amber for ember_deep, the same rust-red
  already used for this screen's own corrosion/DOT icon, so the bot's glow
  reads as "machine" against the rat's warm "living" amber without needing a
  third accent colour. The lens picks that same ember_deep back up as a fill,
  so the one spot of colour on an otherwise pewter-grey body still ties back
  to the halo it is glowing inside.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">

    <!-- Glow: same three-shape halo as ic_rat_silhouette, ember_deep in place
         of amber. -->
    <path
        android:pathData="M36,20 a16,16 0 1,0 -32,0 a16,16 0 1,0 32,0"
        android:fillColor="@color/ember_deep"
        android:fillAlpha="0.30" />
    <path
        android:pathData="M29,20 a9,9 0 1,0 -18,0 a9,9 0 1,0 18,0"
        android:fillColor="@color/ember_deep"
        android:fillAlpha="0.55" />
    <path
        android:pathData="M30.5,20 a10.5,10.5 0 1,0 -21,0 a10.5,10.5 0 1,0 21,0"
        android:fillColor="#00000000"
        android:strokeColor="@color/brass_bright"
        android:strokeAlpha="0.95"
        android:strokeWidth="1.6" />

    <!-- Body: rounded head, a single antenna, and two rivet bolts, all pewter
         fill on a shadow_warm outline - the same fill/stroke pairing the rat
         silhouette's own body uses. -->
    <path
        android:fillColor="@color/pewter"
        android:strokeColor="@color/shadow_warm"
        android:strokeWidth="1.3"
        android:pathData="M15,10 H25 A2,2 0 0 1 27,12 V20 A2,2 0 0 1 25,22 H15
                           A2,2 0 0 1 13,20 V12 A2,2 0 0 1 15,10 Z
                           M19.3,5.5 H20.7 V10 H19.3 Z
                           M21.8,5 A1.8,1.8 0 1,0 18.2,5 A1.8,1.8 0 1,0 21.8,5
                           M16,22 H24 V27 H16 Z
                           M13.4,16 A1.4,1.4 0 1,0 10.6,16 A1.4,1.4 0 1,0 13.4,16
                           M29.4,16 A1.4,1.4 0 1,0 26.6,16 A1.4,1.4 0 1,0 29.4,16" />

    <!-- Lens: the one warm accent on an otherwise cool body, echoing the
         halo it sits inside. -->
    <path
        android:fillColor="@color/ember_deep"
        android:pathData="M23,15.5 A3,3 0 1,0 17,15.5 A3,3 0 1,0 23,15.5" />
    <path
        android:fillColor="@color/cream"
        android:fillAlpha="0.85"
        android:pathData="M19.7,14.3 A0.9,0.9 0 1,0 17.9,14.3 A0.9,0.9 0 1,0 19.7,14.3" />
</vector>
