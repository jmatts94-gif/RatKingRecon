<?xml version="1.0" encoding="utf-8"?>
<!--
  The rat travelling down the hatch tunnel (see hatch_tunnel.xml) - a plain
  silhouette rather than a detailed sprite, since at the size it renders at
  (small, and always in motion) no more detail than "rat-shaped blob with
  ears and a tail" would actually read. Top-down, since it is seen travelling
  through a pipe rather than standing beside one.

  cream rather than a dark silhouette or a gold one - the first pass drew it
  in shadow_warm, the same family of colour the copper pipe already sits in,
  and read as a smudge rather than a marker; the second pass moved to
  brass_bright gold, closer to the pipe's own copper in both hue and value
  than it looked on screen, so the rat was still competing with what it sat
  on rather than standing apart from it. Contrast here is a value problem
  more than a colour one - cream is the palette's lightest warm tone, so a
  cream rat against mid-toned copper reads as a clearly lit shape rather
  than another shade of the same metal. The dark outline is a touch heavier
  (1.3 rather than 1.1) for the same reason: a pale fill needs a stronger
  edge to stay crisp against the tile's own cream-toned background too.

  The glow stays amber rather than following the silhouette to cream: amber
  sits between the panel's background and the rat's own fill, so the two
  still read as distinct steps - a warm halo, then a brighter lit shape
  inside it - rather than the glow disappearing into either neighbour.

  No vector-wide android:tint on purpose - one would recolour the glow along
  with the silhouette, since it applies to the whole drawable rather than to
  one path. Each path carries its own fillColor instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">

    <!-- Glow: two soft filled discs plus a crisp ring, so the halo has a
         visible edge rather than only fading into the background. -->
    <path
        android:pathData="M36,20 a16,16 0 1,0 -32,0 a16,16 0 1,0 32,0"
        android:fillColor="@color/amber"
        android:fillAlpha="0.35" />
    <path
        android:pathData="M29,20 a9,9 0 1,0 -18,0 a9,9 0 1,0 18,0"
        android:fillColor="@color/amber"
        android:fillAlpha="0.6" />
    <path
        android:pathData="M30.5,20 a10.5,10.5 0 1,0 -21,0 a10.5,10.5 0 1,0 21,0"
        android:fillColor="#00000000"
        android:strokeColor="@color/brass_bright"
        android:strokeAlpha="0.95"
        android:strokeWidth="1.6" />

    <!-- The silhouette itself: cream, outlined in the pipe's own dark rim
         tone so it stays crisp sitting inside its own glow. -->
    <path
        android:fillColor="@color/cream"
        android:strokeColor="@color/shadow_warm"
        android:strokeWidth="1.3"
        android:pathData="M27,21 a7,9 0 1,0 -14,0 a7,9 0 1,0 14,0
                           M25,11 a5,5 0 1,0 -10,0 a5,5 0 1,0 10,0
                           M17.5,7 a2.5,2.5 0 1,0 -5,0 a2.5,2.5 0 1,0 5,0
                           M27.5,7 a2.5,2.5 0 1,0 -5,0 a2.5,2.5 0 1,0 5,0
                           M20,29 C23,31 24,36 20,38 C22,34 19,32 20,29 Z" />
</vector>
