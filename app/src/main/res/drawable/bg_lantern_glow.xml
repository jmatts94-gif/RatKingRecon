<?xml version="1.0" encoding="utf-8"?>
<!--
  The light the streak lantern gives off.

  A radial fade rather than a ring or a halo with an edge: light has no border,
  and anything with one reads as a badge stuck behind the icon. The colour is
  brass_bright (#F2B831), the same one the animated frames use for their moving
  parts and chosen there for being brighter than what it sits on - which is what
  a light source has to be.

  The stops carry their own alpha and never reach full opacity, so the centre
  stays light rather than becoming a solid disc behind the lantern. Progress is
  applied on top as the view's own alpha, which multiplies with these.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="#B3F2B831"
        android:centerColor="#4DF2B831"
        android:endColor="#00F2B831" />
</shape>
