<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_card_white's earned counterpart, for a row on the Achievements screen
  whose milestone or badge is already won. Same shape, a pale amber wash
  instead of plain white and an amber border instead of card_border - a
  highlight rather than a second amber block competing with the buttons
  above it, which is why this stays a 20% wash rather than the solid amber
  those use.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#33E8A94F" />
    <stroke
        android:width="1.5dp"
        android:color="@color/amber" />
    <corners android:radius="16dp" />
</shape>
