<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark steampunk's own version of bg_pill_tan.

  The light version's end stop (#F8F0E1) is a hand-picked near-white a few
  percent warmer than card_white, since a colour resource cannot be referenced
  with a modified value inline. Left as that literal hex here, every pill and
  home-screen nav button using it would fade from card_white's own dark value
  at the top into a stray light cream at the bottom - which is exactly the
  bug this file exists to avoid. panel_shade stands in for it instead: a few
  percent off card_white in the same direction the light version's own stop
  is, just darker rather than lighter - and, unlike app_bg_end, not close
  enough to the page itself to undercut the pill's own contrast against it.
  That is the only layer this file needs of its own - every ring above it is
  copied verbatim from the light version, since shadow_warm is already
  themed and copper/copper_shadow/brass_bright/cream deliberately are not
  (see values-night/colors.xml's own comment on that). See the light
  version's own comment for what the rings are and why they exist at all -
  a small brass pipe's own cross-section traced around the tile, the same
  five-tone recipe hatch_tunnel.xml renders its actual pipe with.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/card_white"
                android:endColor="@color/panel_shade"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3.4dp" android:color="@color/shadow_warm" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2.6dp" android:color="@color/copper_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.8dp" android:color="@color/copper" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.9dp" android:color="@color/brass_bright" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="@color/cream" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
