<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark steampunk's own version of bg_pill_arena - see drawable-night/bg_pill_tan.xml,
  which this mirrors for the same reason: the light version's end stop is a
  literal near-white hex that would otherwise fade this tile from card_white's
  dark value into a stray light patch at the bottom - panel_shade instead of
  app_bg_end for the same reason that file uses it too.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/card_white"
        android:endColor="@color/panel_shade"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/copper" />
    <corners android:radius="20dp" />
</shape>
