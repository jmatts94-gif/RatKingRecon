<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark steampunk's own version of bg_pill_arena - see drawable-night/bg_pill_tan.xml,
  which this mirrors for the same reason: the light version's end stop is a
  literal near-white hex that would otherwise fade this tile from card_white's
  dark value into a stray light patch at the bottom - panel_shade instead of
  app_bg_end for the same reason that file uses it too. The brass-pipe rim
  above that fill is copied verbatim from bg_pill_tan.xml's own night
  version, for the same reason the light bg_pill_arena.xml gives.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/card_white"
                android:endColor="@color/panel_shade"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3.4dp" android:color="@color/shadow_warm" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2.6dp" android:color="@color/copper_shadow" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.8dp" android:color="@color/copper" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.9dp" android:color="@color/brass_bright" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="0.5dp" android:color="@color/cream" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</layer-list>
