<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark steampunk's own version of the battle card's inner panel - see the
  light version's own comment. The same substitution bg_hatch_panel.xml's
  night variant already makes: card_white fading to panel_shade, a raised
  surface reading lighter than the page rather than leaning on cream/tan's
  contrast against white, which does not exist in this theme. card_border's
  stroke gives the panel a defined edge inside the brass frame the light
  version does not need one for.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/card_white"
        android:endColor="@color/panel_shade" />
    <stroke
        android:width="1dp"
        android:color="@color/card_border" />
    <corners android:radius="14dp" />
</shape>
