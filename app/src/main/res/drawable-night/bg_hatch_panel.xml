<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark steampunk's own version of the hatch tile panel.

  The light version reuses the page's own cream-to-tan gradient and leans on
  its shadow for definition, which is exactly wrong in a dark theme - a shadow
  that read clearly against cream barely reads at all against near-black, so a
  tile using the *page's* colours here would nearly vanish into it. This uses
  card_white/card_border's own relationship to app_bg instead - a raised panel
  reading lighter than the page behind it, the standard dark-theme cue for
  elevation a shadow alone cannot carry here.

  The gradient's own low end used to fade all the way to app_bg_end, close
  enough to the page itself that the bottom of this - the largest tile on the
  screen, and the first thing it shows - lost the same definition the top of
  it had. panel_shade sits well above the page throughout instead, and
  card_border's own stroke gives the whole shape a defined edge the light
  version relies on cream/tan's own contrast against white to not need.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/card_white"
        android:endColor="@color/panel_shade" />
    <stroke
        android:width="1dp"
        android:color="@color/card_border" />
    <corners android:radius="24dp" />
</shape>
