<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Pinned to a Light parent on purpose. The palette is hardcoded warm cream,
      which does not invert, so a DayNight parent would mix our light surfaces
      with dark Material chrome in night mode.
    -->
    <style name="Base.Theme.RatKingRecon" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/cream</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Warm shadows on every button; see values-v28/styles.xml. -->
        <item name="materialButtonStyle">@style/Widget.RatKing.Button</item>
        <item name="android:navigationBarColor">@color/tan</item>
        <!--
          API 27+, and minSdk is 24. Not split into a values-v27 variant because
          the platform simply ignores a theme attribute it does not know, so the
          only thing a variant would buy is three more copies of this style to
          keep in step - there is already a night one that exists purely to be
          identical. On 24-26 the navigation bar keeps light icons on tan, which
          is legible; from 27 it gets the dark ones the palette wants.
        -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.RatKingRecon" parent="Base.Theme.RatKingRecon" />
</resources>
