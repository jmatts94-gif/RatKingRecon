<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Backgrounds: warm cream fading to tan -->
    <color name="cream">#FBF3E3</color>
    <color name="tan">#F5E6C8</color>

    <!-- Primary accent, used for main action buttons -->
    <color name="amber">#E8A94F</color>
    <color name="amber_dark">#C98B36</color>

    <!-- Card surfaces -->
    <color name="card_white">#FFFFFF</color>
    <color name="card_border">#E8D6AE</color>

    <!-- Text -->
    <color name="text_primary">#6B4A1E</color>
    <color name="text_muted">#8A7255</color>

    <!-- Status accents, kept warm so they sit inside the palette -->
    <color name="shiny_gold">#D9A425</color>
    <color name="disabled_fill">#EDE2CC</color>

    <!-- Dismiss actions: warm terracotta rather than a clashing red -->
    <color name="terracotta">#C1673F</color>

    <!-- Animated Binder frames. Kept inside the warm palette so a frame reads
         as part of the workshop rather than as a sticker on top of it. -->
    <color name="copper">#B87333</color>
    <color name="pewter">#9A8B76</color>

    <!--
      The hatch tunnel's pipe (hatch_tunnel.xml) reads as more than two flat
      tones by stepping through this on the way from shadow_warm's rim down
      to copper's lit body - one more stop in the same gradient rather than
      a second colour competing with it.
    -->
    <color name="copper_shadow">#8C5426</color>

    <!--
      The moving parts of an animated frame, deliberately brighter than the
      border they sit on. Copper cogs on a copper border read as texture rather
      than as machinery, and pewter steam on white barely reads at all.
    -->
    <color name="brass_bright">#F2B831</color>
    <color name="boiler_glow">#FF8A3D</color>

    <!-- The two ends of the Ember frame's pulse: hot orange down to deep red. -->
    <color name="ember_hot">#FF8C42</color>
    <color name="ember_deep">#B3301C</color>

    <!--
      What a shadow is made of here.

      Android casts shadows in near-black by default, which over cream reads as
      grey haze rather than depth - the surface looks dirty instead of lifted.
      A deep warm brown is the same colour the palette already uses for text,
      taken darker, so a shadow looks like less light rather than like soot.
    -->
    <color name="shadow_warm">#4A2F0F</color>

    <!--
      The dimming behind the home-screen walkthrough. The same warm brown a
      shadow is made of, at 72%, so the screen reads as turned down rather than
      as covered by a grey sheet.
    -->
    <color name="coach_scrim">#B84A2F0F</color>

    <!--
      Combat accent: Power Surge, the Golden Wrench, and everywhere either is
      shown as armed. Deliberately cool rather than a lighter or darker amber -
      the app's owner is partially colour blind, and a warm palette leaning on
      hue alone to separate "combat" from everything else risked landing on a
      red/green pair they cannot reliably tell apart. Slate teal sits far enough
      from both amber and rust to read as a different signal by anyone.
    -->
    <color name="teal_bg">#EAF3F0</color>
    <color name="teal_border">#BFDDD5</color>
    <color name="teal_fill">#3E8A73</color>

    <!--
      The Aether Coil frame's pulse: pale blue-white brightening to a richer
      blue and back. Deliberately outside the warm palette every other frame
      above sits inside - an energy arc that read as warm brass or copper
      would just be another Boiler. The one other cool exception in this file
      (teal, above) broke the same rule for accessibility; this one breaks it
      because "energy" reading as warm metal would not read as energy at all.
    -->
    <color name="aether_border">#5C87AC</color>
    <color name="aether_glow">#D6EEFF</color>
    <color name="aether_deep">#3E86C4</color>

    <!--
      The Battle Arena: the one screen in the app that deliberately breaks
      from the warm-on-cream palette everywhere else, for the "end game"
      contrast the mode is meant to carry. Kept inside the same warm hue
      family - copper and brass_bright, already what the Clockwork frame's
      gears and the streak lantern's glow are made of - rather than reaching
      for a new colour, so it reads as this game turned up, not a different
      app. Deliberately nowhere near red/green, the one pairing this app's
      colour-blind owner cannot reliably tell apart.
    -->
    <color name="arena_bg_deep">#1C130A</color>
    <color name="arena_text_muted">#B7A489</color>

    <!--
      Champion's Banner (Frames.ARENA_CHAMPION) - the one FrameStyle.SCARRED
      frame. A near-black warm brown rather than a true cold grey - every
      other "metal" already in this app (pewter, copper) stays inside the
      warm family, and a grey stroke here would be the one frame that broke
      it. The cracks pulse between brass_bright and copper, the same pair
      arena_bg_deep's own comment already ties to the Arena's screens.
    -->
    <color name="scarred_iron">#3A2E22</color>
</resources>
