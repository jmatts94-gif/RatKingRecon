<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Backgrounds: warm cream fading to tan -->
    <color name="cream">#FBF3E3</color>
    <color name="tan">#F5E6C8</color>

    <!-- Primary accent, used for main action buttons -->
    <color name="amber">#E8A94F</color>
    <color name="amber_dark">#C98B36</color>

    <!-- Card surfaces -->
    <color name="card_white">#FFFFFF</color>
    <color name="card_border">#E8D6AE</color>

    <!-- Text -->
    <color name="text_primary">#6B4A1E</color>
    <color name="text_muted">#8A7255</color>

    <!-- Status accents, kept warm so they sit inside the palette -->
    <color name="shiny_gold">#D9A425</color>
    <color name="disabled_fill">#EDE2CC</color>

    <!-- Dismiss actions: warm terracotta rather than a clashing red -->
    <color name="terracotta">#C1673F</color>

    <!-- Animated Binder frames. Kept inside the warm palette so a frame reads
         as part of the workshop rather than as a sticker on top of it. -->
    <color name="copper">#B87333</color>
    <color name="pewter">#9A8B76</color>

    <!--
      The moving parts of an animated frame, deliberately brighter than the
      border they sit on. Copper cogs on a copper border read as texture rather
      than as machinery, and pewter steam on white barely reads at all.
    -->
    <color name="brass_bright">#F2B831</color>
    <color name="boiler_glow">#FF8A3D</color>

    <!-- The two ends of the Ember frame's pulse: hot orange down to deep red. -->
    <color name="ember_hot">#FF8C42</color>
    <color name="ember_deep">#B3301C</color>

    <!--
      What a shadow is made of here.

      Android casts shadows in near-black by default, which over cream reads as
      grey haze rather than depth - the surface looks dirty instead of lifted.
      A deep warm brown is the same colour the palette already uses for text,
      taken darker, so a shadow looks like less light rather than like soot.
    -->
    <color name="shadow_warm">#4A2F0F</color>

    <!--
      The dimming behind the home-screen walkthrough. The same warm brown a
      shadow is made of, at 72%, so the screen reads as turned down rather than
      as covered by a grey sheet.
    -->
    <color name="coach_scrim">#B84A2F0F</color>
</resources>
