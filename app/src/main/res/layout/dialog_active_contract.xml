<?xml version="1.0" encoding="utf-8"?>
<!--
  The contract currently running. Shown in place of the offers board while one
  is active, where a toast used to say only that there was one.

  Deliberately built from the same pieces as the rest of the app: the board's
  card background, the Ledger's tan pill, and the EXP bar's amber progress
  drawable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/contract_active_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/activeContractName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textAlignment="center"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <!-- Progress towards the step goal -->
    <TextView
        android:id="@+id/activeContractSteps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill_tan"
        android:elevation="6dp"
        android:outlineAmbientShadowColor="@color/shadow_warm"
        android:outlineSpotShadowColor="@color/shadow_warm"
        tools:targetApi="28"
        android:drawableStart="@drawable/ic_footprint"
        android:drawablePadding="6dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/activeContractProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginBottom="16dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_amber" />

    <TextView
        android:id="@+id/activeContractTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/activeContractReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseActiveContract"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_close"
        android:textAllCaps="false"
        android:textColor="@color/card_white"
        app:backgroundTint="@color/terracotta"
        app:cornerRadius="16dp" />

</LinearLayout>
