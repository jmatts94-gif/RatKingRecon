<?xml version="1.0" encoding="utf-8"?>
<!--
  Tasks: the Contract Board and the Ledger Tasks, one screen, two sections.

  A UI consolidation and nothing more. The two systems keep their own rewards,
  their own timers and their own save keys - a Contract still resolves itself
  against the step counter and a Ledger Task still runs on a wall clock and waits
  to be claimed. They simply stopped needing a home-screen button each.

  The Contracts section has two faces and shows one at a time: the board of
  offers when nothing is running, and the contract in progress when something
  is. Both were dialogs before.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tasks_title"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:layout_marginBottom="16dp" />

            <!-- ============ Contracts ============ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tasks_section_contracts"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="@string/tasks_section_contracts_sub"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Live step count, kept visible while a contract runs. -->
            <TextView
                android:id="@+id/bountyStepCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_pill_tan"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:drawableStart="@drawable/ic_footprint"
                android:drawablePadding="6dp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/header_steps_default"
                android:layout_marginBottom="12dp" />

            <!-- Face one: the board, when nothing is running. -->
            <LinearLayout
                android:id="@+id/contractOffers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBountyShort"
                    android:maxLines="3"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/card_white"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="16dp"
                    app:elevation="4dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBountyMedium"
                    android:maxLines="3"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/card_white"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="16dp"
                    app:elevation="4dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBountyLong"
                    android:maxLines="3"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    app:backgroundTint="@color/card_white"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="16dp"
                    app:elevation="4dp" />
            </LinearLayout>

            <!-- Face two: the contract already running. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/contractActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/activeContractName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/activeContractSteps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/activeContractProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="8dp"
                        android:progressDrawable="@drawable/progress_amber"
                        android:max="100" />

                    <TextView
                        android:id="@+id/activeContractTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/activeContractReward"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Ledger Tasks ============ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/tasks_section_ledger"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"
                android:text="@string/tasks_section_ledger_sub"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Relics only ever accumulated in the save before; this is where they surface. -->
            <TextView
                android:id="@+id/relicCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_pill_tan"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:drawableStart="@drawable/ic_star"
                android:drawablePadding="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:id="@+id/titleM1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading…" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/reqM1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Requires: …" android:textColor="@color/text_muted" android:textSize="13sp"/>
                    <TextView android:id="@+id/rewardM1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time: 2 Hours  |  Reward: …" android:textColor="@color/text_muted" android:textSize="13sp" android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMission1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mission_checking_roster"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="14dp"
                        app:elevation="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:id="@+id/titleM2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading…" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/reqM2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Requires: …" android:textColor="@color/text_muted" android:textSize="13sp"/>
                    <TextView android:id="@+id/rewardM2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time: 8 Hours  |  Reward: …" android:textColor="@color/text_muted" android:textSize="13sp" android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMission2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mission_checking_roster"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="14dp"
                        app:elevation="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="5dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView android:id="@+id/titleM3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loading…" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/reqM3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Requires: …" android:textColor="@color/text_muted" android:textSize="13sp"/>
                    <TextView android:id="@+id/rewardM3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time: 24 Hours  |  Reward: …" android:textColor="@color/text_muted" android:textSize="13sp" android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMission3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mission_checking_roster"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="14dp"
                        app:elevation="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/btn_back_to_workshop"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/card_white"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        app:cornerRadius="16dp"
        app:elevation="4dp" />

</LinearLayout>
