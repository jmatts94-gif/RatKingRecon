<?xml version="1.0" encoding="utf-8"?>
<!--
  One row on the Achievements screen, shared by the boss badges and the three
  milestone categories. A locked row keeps the same layout and dims its icon
  rather than hiding it, so the shape of what is still to come stays readable.
  An earned row swaps bg_card_white for the amber-washed bg_card_earned and
  shows the checkmark - see AchievementsActivity.row(), which sets both from
  the same "unlocked" boolean this layout otherwise knows nothing about.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:outlineAmbientShadowColor="@color/shadow_warm"
    android:outlineSpotShadowColor="@color/shadow_warm"
    tools:targetApi="28"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/achievementIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/achievementName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/achievementDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/achievementProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_amber"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Shown only once earned - see AchievementsActivity.row(). -->
    <ImageView
        android:id="@+id/achievementCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_check"
        android:contentDescription="@null"
        android:visibility="gone" />

</LinearLayout>
