<?xml version="1.0" encoding="utf-8"?>
<!--
  One row in the Ledger Task faction picker - see TasksActivity.pickRatFor.

  Background and text colors are swapped between bg_card_white/text_primary
  and bg_card_muted/text_muted in code - the same disabled treatment the Shop
  already uses for an option the player cannot take right now, rather than a
  new one invented for this dialog.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pickRatRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:outlineAmbientShadowColor="@color/shadow_warm"
    android:outlineSpotShadowColor="@color/shadow_warm"
    tools:targetApi="28"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/pickRatRowTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Smugglers" />

    <TextView
        android:id="@+id/pickRatRowDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="+15% Scrap on completion" />

</LinearLayout>
