<?xml version="1.0" encoding="utf-8"?>
<!-- Boot Camp: shown once, when the starter rat hatches on a fresh save. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_card_white"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootcamp_title"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/bootCampRatImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="fitCenter"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/bootCampRatName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/bootCampRatStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bootcamp_body"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textAlignment="center"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bootCampFightButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/bootcamp_fight"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:icon="@drawable/ic_power"
        app:iconGravity="textStart"
        app:iconTint="@color/text_primary"
        app:backgroundTint="@color/amber"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bootCampLaterButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="@string/bootcamp_later"
        android:textAllCaps="false"
        android:textColor="@color/text_muted" />

</LinearLayout>
