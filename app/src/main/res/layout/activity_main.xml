<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <!--
      clipChildren is off on the plain containers, and that is what makes the
      depth visible rather than merely present. An elevation shadow is drawn
      outside the view casting it, so a parent clipping to its children's bounds
      cuts the shadow off flush against the edge - the lift is computed, then
      thrown away, and the result looks flat for no apparent reason.

      It is deliberately NOT off on the ScrollView above, and must not be. That
      clip is the scroll viewport: without it the content is no longer confined
      to the scrolling area and draws over whatever sits outside it, which on
      the Shop meant rows sliding straight across the pinned back button.
      clipToPadding is the one a scroll container wants - it lets a shadow reach
      into the padding without letting the content escape the view.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="20dp">

        <!-- Header: level, live steps, scrap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="20dp">

            <!--
              elevation, not a drawn shadow: Android takes the outline from the
              pill's rounded corners and casts a real one, which costs nothing
              and stays correct if the radius ever changes.
            -->
            <TextView
                android:id="@+id/playerLevelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_tan"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_level_default" />

            <TextView
                android:id="@+id/stepCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_tan"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_footprint"
                android:drawablePadding="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_steps_default" />

            <TextView
                android:id="@+id/scrapText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_tan"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_scrap"
                android:drawablePadding="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_scrap_default" />
        </LinearLayout>

        <TextView
            android:id="@+id/expText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:text="0 / 50 EXP"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/expProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progressDrawable="@drawable/progress_amber"
            android:max="50"
            android:progress="0"
            android:layout_marginBottom="20dp" />

        <!--
          Egg. The artwork itself changes stage as EXP fills.

          The panel is lifted off the cream background, and the egg sits in a
          contact shadow drawn underneath it rather than on an elevation of its
          own - elevation would trace the ImageView's rectangle, and the egg is
          not a rectangle.
        -->
        <!--
          The egg and its companion tile, three parts to one, both square.

          Sized off the width available rather than pinned to a fixed 260dp,
          which is what lets the tile be a tile. A fixed egg leaves 60dp beside
          it on a 360dp screen, and nothing square and readable fits in 60dp -
          the tile could only be the narrow strip it was. Sharing the row as a
          weighted chain gives both of them the same shape and lets them grow
          together on a larger screen instead of leaving it empty.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="20dp">

        <FrameLayout
            android:id="@+id/eggPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintHorizontal_weight="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/streakTile"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_egg_panel"
            android:elevation="14dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            android:clipChildren="false"
            tools:targetApi="28">

            <View
                android:layout_width="150dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="34dp"
                android:background="@drawable/egg_contact_shadow" />

            <ImageView
                android:id="@+id/petImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/egg_stage_0" />
        </FrameLayout>

            <!--
              Streak tile: lantern, then the count. Opens today's quest.

              Square, and a third of the egg's width, so it reads as a smaller
              copy of the panel next to it rather than a strip stuck to its
              side. It carries the egg's 14dp elevation rather than the 6dp the
              currency pills use - the two of them are one object on the screen
              and a matched pair should cast a matched shadow.
            -->
            <LinearLayout
                android:id="@+id/streakTile"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/eggPanel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="@id/eggPanel"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_pill_tan"
                android:elevation="14dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true">

                <!--
                  The lantern takes the whole tile bar the count beneath it,
                  the way the egg takes its whole panel bar its padding. Given
                  in weight rather than dp because the tile itself is measured,
                  not fixed: whatever width the row leaves over, the lantern
                  grows into.
                -->
                <ImageView
                    android:id="@+id/streakLantern"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_lantern"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/streakCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:text="@string/header_scrap_default" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--
          The Shop takes the slot the two consumables used to occupy, but is
          deliberately NOT inside shopLayout: it is now the only way in to those
          items, so inheriting their level gate would hide them outright.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/shopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_shop"
            app:icon="@drawable/ic_store"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/activeExpeditionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expedition_status"
            app:icon="@drawable/ic_pets"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/amber"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!--
          One button for both boards. Contracts and Ledger Tasks are still two
          systems with their own rewards and timers; they share a screen now
          rather than a button each, which is what freed the slot.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tasksButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_tasks"
            app:icon="@drawable/ic_contract"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openGalleryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_ledger"
            app:icon="@drawable/ic_book"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/achievementsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_achievements"
            app:icon="@drawable/ic_star"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/devResetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_dev_reset"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp" />

    </LinearLayout>

</ScrollView>
