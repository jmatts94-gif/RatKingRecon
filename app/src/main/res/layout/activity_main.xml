<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <!--
      clipChildren is off on the plain containers, and that is what makes the
      depth visible rather than merely present. An elevation shadow is drawn
      outside the view casting it, so a parent clipping to its children's bounds
      cuts the shadow off flush against the edge - the lift is computed, then
      thrown away, and the result looks flat for no apparent reason.

      It is deliberately NOT off on the ScrollView above, and must not be. That
      clip is the scroll viewport: without it the content is no longer confined
      to the scrolling area and draws over whatever sits outside it, which on
      the Shop meant rows sliding straight across the pinned back button.
      clipToPadding is the one a scroll container wants - it lets a shadow reach
      into the padding without letting the content escape the view.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="20dp">

        <!-- Header: level, live steps, scrap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="20dp">

            <!--
              elevation, not a drawn shadow: Android takes the outline from the
              pill's rounded corners and casts a real one, which costs nothing
              and stays correct if the radius ever changes.
            -->
            <TextView
                android:id="@+id/playerLevelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_tan"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_level_default" />

            <TextView
                android:id="@+id/stepCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_tan"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_footprint"
                android:drawablePadding="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_steps_default" />

            <TextView
                android:id="@+id/scrapText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_tan"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/shadow_warm"
                android:outlineSpotShadowColor="@color/shadow_warm"
                tools:targetApi="28"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_scrap"
                android:drawablePadding="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_scrap_default" />
        </LinearLayout>

        <TextView
            android:id="@+id/expText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:text="0 / 50 EXP"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/expProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progressDrawable="@drawable/progress_amber"
            android:max="50"
            android:progress="0"
            android:layout_marginBottom="20dp" />

        <!--
          Egg. The artwork itself changes stage as EXP fills.

          The panel is lifted off the cream background, and the egg sits in a
          contact shadow drawn underneath it rather than on an elevation of its
          own - elevation would trace the ImageView's rectangle, and the egg is
          not a rectangle.
        -->
        <!--
          The egg and the tiles that stand beside it, an even split.

          Sized off the width available rather than pinned to a fixed 260dp.
          Sharing the row as a weighted chain lets both halves grow together on
          a larger screen instead of leaving it empty.

          One tile beside the egg was tried at two sizes and never sat right.
          Three now share that half, stacked, and the stack is measured against
          the egg rather than given a height of its own: the column is pinned to
          the egg's top and bottom, so the group is exactly as tall as the egg
          at any screen size, and the tiles inside divide whatever that comes to.
          Nothing here is a fixed dp, which is why the arrangement holds from a
          320dp phone to a tablet.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_marginBottom="20dp">

        <FrameLayout
            android:id="@+id/eggPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tileColumn"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_egg_panel"
            android:elevation="14dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            android:clipChildren="false"
            tools:targetApi="28">

            <View
                android:layout_width="150dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="34dp"
                android:background="@drawable/egg_contact_shadow" />

            <ImageView
                android:id="@+id/petImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/egg_stage_0" />
        </FrameLayout>

            <!--
              The three tiles beside the egg.

              Height is taken from the egg rather than declared: top and bottom
              are pinned to the panel, so the column is the egg's height and the
              three tiles inside divide it by weight. The two 8dp gaps come out
              of that same total, so the group always finishes flush with the
              egg's bottom edge however tall the row ends up.

              The tiles sit at the 6dp the currency pills use, not the egg's
              14dp. They were matched to the egg at first, on the reasoning that
              a matched pair should cast a matched shadow - but three tiles
              lifted as high as the egg made four things competing to be the
              front of the screen. The egg keeps the height; the tiles read as
              what they are, which is support around it.
            -->
            <LinearLayout
                android:id="@+id/tileColumn"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/eggPanel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/eggPanel"
                app:layout_constraintBottom_toBottomOf="@id/eggPanel"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!--
                  Scrap Run status. Display only - a run is still started and
                  collected on the Ledger, and this never claims one.
                -->
                <LinearLayout
                    android:id="@+id/expeditionTile"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_pill_tan"
                    android:elevation="6dp"
                    android:outlineAmbientShadowColor="@color/shadow_warm"
                    android:outlineSpotShadowColor="@color/shadow_warm"
                    tools:targetApi="28">

                    <ImageView
                        android:id="@+id/expeditionIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_expedition"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/expeditionStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="@string/tile_expedition_idle" />
                </LinearLayout>

                <!--
                  Today's steps, with the distance they come to underneath. The
                  count is the same daily total the notification keeps; the
                  distance is an estimate off an average stride.
                -->
                <LinearLayout
                    android:id="@+id/stepsTile"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_pill_tan"
                    android:elevation="6dp"
                    android:outlineAmbientShadowColor="@color/shadow_warm"
                    android:outlineSpotShadowColor="@color/shadow_warm"
                    tools:targetApi="28">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_footprint"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/stepsTileCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="1240 steps" />

                        <TextView
                            android:id="@+id/stepsTileDistance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            tools:text="0.9 km" />
                    </LinearLayout>
                </LinearLayout>

                <!--
                  The streak tile, unchanged in what it does: it still opens
                  today's quest, the lantern still carries the four stages, and
                  the count is still the streak. Only the shape is new - laid
                  out across rather than down, to match the two tiles above it.
                -->
                <LinearLayout
                    android:id="@+id/streakTile"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_pill_tan"
                    android:elevation="6dp"
                    android:outlineAmbientShadowColor="@color/shadow_warm"
                    android:outlineSpotShadowColor="@color/shadow_warm"
                    tools:targetApi="28"
                    android:clickable="true"
                    android:focusable="true">

                    <!--
                      Larger than the 22dp icons above it, and deliberately so.
                      ic_lantern draws inside a 24x24 viewport but only fills
                      about 42% of its width and 73% of its height, where the
                      Material icons in the other two tiles fill roughly 83% of
                      both. At a matched 22dp the lantern therefore rendered
                      about 9dp of actual artwork across, and the tile read as
                      mostly empty. The extra size buys the ink back.
                    -->
                    <ImageView
                        android:id="@+id/streakLantern"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_lantern"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/streakCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:text="@string/header_scrap_default" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!--
          The Shop takes the slot the two consumables used to occupy, but is
          deliberately NOT inside shopLayout: it is now the only way in to those
          items, so inheriting their level gate would hide them outright.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/shopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_shop"
            app:icon="@drawable/ic_store"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/activeExpeditionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expedition_status"
            app:icon="@drawable/ic_pets"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/amber"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!--
          One button for both boards. Contracts and Ledger Tasks are still two
          systems with their own rewards and timers; they share a screen now
          rather than a button each, which is what freed the slot.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tasksButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_tasks"
            app:icon="@drawable/ic_contract"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openGalleryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_ledger"
            app:icon="@drawable/ic_book"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/achievementsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_achievements"
            app:icon="@drawable/ic_star"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_settings"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/devResetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_dev_reset"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp" />

    </LinearLayout>

</ScrollView>
