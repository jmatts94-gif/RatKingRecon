<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Header: level, live steps, scrap -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/playerLevelText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_tan"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_level_default" />

            <TextView
                android:id="@+id/stepCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_tan"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_footprint"
                android:drawablePadding="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_steps_default" />

            <TextView
                android:id="@+id/scrapText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_tan"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_hexagon"
                android:drawablePadding="6dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:text="@string/header_scrap_default" />
        </LinearLayout>

        <TextView
            android:id="@+id/expText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_muted"
            android:text="0 / 50 EXP"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/expProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:progressDrawable="@drawable/progress_amber"
            android:max="50"
            android:progress="0"
            android:layout_marginBottom="20dp" />

        <!-- Egg. The artwork itself changes stage as EXP fills. -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/bg_egg_panel"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/petImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/egg_stage_0" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/shopLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <!--
              Tinkerer's Serum has moved to the future Shop screen. Its purchase
              logic still exists in MainActivity but is unreachable until then.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buyPolishButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_polish_buy"
                app:icon="@drawable/ic_sparkle"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/text_primary"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buyPremiumButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_premium"
                app:icon="@drawable/ic_egg"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/text_primary"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/amber"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/activeExpeditionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expedition_status"
            app:icon="@drawable/ic_pets"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/amber"
            app:cornerRadius="16dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scavengeMissionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_contract_board"
            app:icon="@drawable/ic_contract"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expeditionBoardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_expedition_board"
            app:icon="@drawable/ic_expedition"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openGalleryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_ledger"
            app:icon="@drawable/ic_book"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Placeholder: there is no ShopActivity yet, so this only explains itself. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/shopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_shop"
            app:icon="@drawable/ic_store"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/devResetButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_dev_reset"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp" />

    </LinearLayout>

</ScrollView>
