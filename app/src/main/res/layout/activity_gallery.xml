<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_app_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/collectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/collection_default_text"
            android:textColor="@color/text_muted"
            android:textAlignment="center"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <ProgressBar
            android:id="@+id/collectionProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:progressDrawable="@drawable/progress_amber"
            android:progress="0" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/workshop_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp" />

    <!-- The Serum and Gleam buttons that sat here were inert; both are sold in the Shop. -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/spliceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/fusion_pot_text"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/amber"
        app:cornerRadius="16dp"
        app:elevation="4dp" />

    <!-- Filters. Previously untinted, so they inherited the theme's purple. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_all"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_power"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShiny"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_shiny"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                android:layout_marginEnd="8dp" />

            <!--
              A fourth filter fits the row without crowding it - this row was
              already a HorizontalScrollView, anticipating exactly this, so it
              scrolls rather than wraps or clips if a phone is narrow enough
              that four buttons run past the edge.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRarity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_rarity"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                app:elevation="4dp"
                android:layout_marginEnd="8dp" />

            <!--
              Not a fifth sort - it leaves the grid entirely, which is why it
              is tinted amber rather than the plain card_white the four sorts
              share. Same scrollable row regardless, since a player reaching
              for "what does this faction actually do" is reaching from right
              here, already thinking about faction.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFactionCodex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_faction_codex"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/amber"
                app:cornerRadius="16dp"
                app:elevation="4dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!--
      A RecyclerView rather than a GridLayout in a ScrollView. The old grid
      inflated one live view per rat and kept every one of them attached, so a
      long-running collection cost memory and layout time in proportion to its
      size. Three columns, as before.
    -->
    <!--
      The grid and its empty state share the slot, so whichever is showing gets
      the same space and the screen does not change shape when the first rat
      hatches.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/petGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="4dp"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="3" />

        <LinearLayout
            android:id="@+id/petGridEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_egg"
                android:alpha="0.55"
                android:layout_marginBottom="14dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/petGridEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/petGridEmptyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAlignment="center"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/returnToBaseButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/btn_back_to_workshop"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/card_white"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        app:cornerRadius="16dp"
        app:elevation="4dp" />
</LinearLayout>
