<?xml version="1.0" encoding="utf-8"?>
<!--
  One row in the Item Voucher's picker - see dialog_item_voucher.xml and
  RelicTraderActivity.chooseItemVoucher. Every item listed here already
  passed RelicTrader.availableItemChoices, so unlike item_battle_item.xml
  there is no held count and the button is never disabled.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_white"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <ImageView
        android:id="@+id/voucherChoiceIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_flask" />

    <TextView
        android:id="@+id/voucherChoiceLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        tools:text="HP Tonic" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/voucherChoicePickButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/trade_action"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/amber"
        app:cornerRadius="14dp" />

</LinearLayout>
