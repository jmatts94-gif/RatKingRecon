<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/contract_board_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/contract_board_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:textAlignment="center"
        android:layout_marginBottom="12dp" />

    <!-- Live step counter, kept visible while a bounty is running. -->
    <TextView
        android:id="@+id/bountyStepCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_tan"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:drawableStart="@drawable/ic_footprint"
        android:drawablePadding="6dp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="14sp"
        android:text="@string/header_steps_default"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuickHaul"
        android:maxLines="3"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:text="Quick Haul (50 Steps / 2m)\nReward: 50 Scrap"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/card_white"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        app:cornerRadius="16dp"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopperWire"
        android:maxLines="3"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:text="Copper Wire Raid (250 Steps / 10m)\nReward: 300 Scrap"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/card_white"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        app:cornerRadius="16dp"
        android:layout_marginBottom="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIndustrial"
        android:maxLines="3"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:text="Industrial Scavenge (1000 Steps / 30m)\nReward: 1500 Scrap"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/card_white"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp"
        app:cornerRadius="16dp"
        android:layout_marginBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelBounty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_shut_the_board"
        android:textAllCaps="false"
        android:textColor="@color/card_white"
        app:backgroundTint="@color/terracotta"
        app:cornerRadius="16dp" />

</LinearLayout>
