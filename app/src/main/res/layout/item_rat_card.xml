<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="192dp"
    android:layout_margin="4dp"
    android:outlineAmbientShadowColor="@color/shadow_warm"
    android:outlineSpotShadowColor="@color/shadow_warm"
    tools:targetApi="28"
    app:cardBackgroundColor="@color/card_white"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/cardName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mutant"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textAlignment="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/tan"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/cardImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/newwegg_pic" />

            <!--
              Rarity, readable at a glance without reading the line under the
              stats: one gear per tier, in the corner the eye lands on first.
            -->
            <LinearLayout
                android:id="@+id/cardGears"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_badge_scrim"
                android:paddingHorizontal="3dp"
                android:paddingVertical="2dp">

                <ImageView
                    android:id="@+id/cardGear1"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/cream"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/cardGear2"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/cream"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/cardGear3"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/cream"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!--
              Out on the Scrap Run - see RatCardAdapter.onBindViewHolder and
              its own wobbleForever. bottom|start rather than the gears'
              top|start, so the two badges never fight for the same corner;
              gone by default, since at most one rat in the whole roster is
              ever deployed at once.
            -->
            <ImageView
                android:id="@+id/cardTaskBadge"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="4dp"
                android:background="@drawable/bg_badge_scrim"
                android:padding="2dp"
                android:visibility="gone"
                android:src="@drawable/ic_contract"
                app:tint="@color/cream"
                android:contentDescription="@string/card_task_badge_description"
                tools:visibility="visible" />
        </com.google.android.material.card.MaterialCardView>

        <!--
          wrap_content on both, with a flexible spacer between them - not
          weight=1 with gravity="end" on the Toughness side, which was the
          original bug. A compound drawable anchors to its own view's start
          edge no matter what gravity says; gravity only moves the text, so
          "end" gravity on a wide weighted TextView drags the number away
          from an icon that never moved, opening a gap between them. A
          wrap_content TextView has no slack for gravity to shift anything
          in, so the icon and its number always sit exactly as tight as
          drawablePadding says - the spacer is what pushes the pair as a
          whole to the right, rather than gravity trying to.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/cardPower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:drawableStart="@drawable/ic_power"
                android:drawablePadding="3dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center_vertical" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/cardToughness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:drawableStart="@drawable/ic_toughness"
                android:drawablePadding="3dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center_vertical" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Draws the animated Binder frame over the card. Last child of the
      MaterialCardView, which is a FrameLayout, so it sits on top without
      affecting the layout underneath. Left with no background unless an
      animated frame is equipped, in which case it costs nothing.

      Not the card's own foreground: Material uses that for its ripple and
      checked overlays.
    -->
    <View
        android:id="@+id/cardFrameOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</com.google.android.material.card.MaterialCardView>
