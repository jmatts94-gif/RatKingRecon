<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battle_title"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <!--
          Rustbot - a brass-outer/cream-inner nesting in the same family as
          the Recon Card and the enlarged rat dialog (bg_recon_card_outer/
          _inner), rather than the plain flat white MaterialCardView this
          screen drew before: everywhere else a card gets this treatment,
          the battle screen's own two were the one place still reading as a
          stock Material card next to it. Its own drawables rather than
          reusing those directly - see bg_battle_card_outer.xml - since
          those two are sized for a tall 320dp-wide portrait card, not a
          short full-width info row, and their inner panel is fixed cream
          regardless of theme, which is exactly wrong for a screen meant to
          keep following the player's Dark Steampunk toggle the way the
          rest of the app does. A plain LinearLayout rather than
          MaterialCardView, since app:cardBackgroundColor only takes a
          colour - a gradient background needs a real View background, the
          same substitution dialog_enlarged_rat.xml's own enlargedCardBorder
          already made. android:elevation on a shape drawable still casts a
          real shadow (the default outline comes straight from the
          drawable's own rounded rect), so nothing about the lift is lost -
          only its colour changes, to the same warm shadow_warm tone the
          battle log below already casts rather than Android's default
          near-black.
        -->
        <LinearLayout
            android:id="@+id/botCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_battle_card_outer"
            android:padding="4dp"
            android:elevation="2dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_battle_card_inner"
                android:clipChildren="false"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/botName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rustbot"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!--
                      Status icons - see Battle.botDotActive / botCharging and
                      BattleActivity.renderStatusIcons. Both gone by default;
                      at most one is ever visible at once (a charging boss has
                      no reply of its own to have applied a DOT with yet).
                    -->
                    <ImageView
                        android:id="@+id/botDotIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_settings"
                        android:visibility="gone"
                        android:contentDescription="@string/battle_status_dot"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/botChargingIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_sparkle"
                        android:visibility="gone"
                        android:contentDescription="@string/battle_status_charging"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/botStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <ProgressBar
                    android:id="@+id/botHpBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:progressDrawable="@drawable/progress_amber" />
            </LinearLayout>
        </LinearLayout>

        <!-- Your rat - the same brass-outer/cream-inner nesting as botCard above. -->
        <LinearLayout
            android:id="@+id/ratCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_battle_card_outer"
            android:padding="4dp"
            android:elevation="2dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_battle_card_inner"
                android:clipChildren="false"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="14dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/ratImage"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/battle_title" />

                    <!--
                      The faction's own glyph - the same one CardIcons.faction
                      draws beside a rat's name everywhere else - popped over
                      the portrait for the moment a Special fires, then faded
                      back out. See BattleActivity.flashFactionSpecial.
                      Invisible and untouched otherwise: this never carries a
                      background or click target of its own, so it costs
                      nothing on every round that isn't a Special.
                    -->
                    <ImageView
                        android:id="@+id/specialGlyph"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_badge_scrim"
                        android:padding="6dp"
                        android:alpha="0"
                        android:visibility="gone"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/ic_faction_brawlers"
                        tools:tint="@color/brass_bright"
                        tools:visibility="visible" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/ratName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- See Battle.ratDotActive - a boss's own corrosion
                             (e.g. Old Ironclaw's Rusty Rake) ticking on the rat. -->
                        <ImageView
                            android:id="@+id/ratDotIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="6dp"
                            android:src="@drawable/ic_settings"
                            android:visibility="gone"
                            android:contentDescription="@string/battle_status_dot"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ratStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp" />

                    <ProgressBar
                        android:id="@+id/ratHpBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:progressDrawable="@drawable/progress_amber" />

                    <!--
                      Power Surge / Golden Wrench, whichever the Shop armed for
                      this fight. Read once when the fight is built and never
                      touched again here - the flag it reflects only changes
                      when the fight resolves, by which point this screen is on
                      its way to the result dialog.
                    -->
                    <LinearLayout
                        android:id="@+id/activeBuffBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_card_teal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/activeBuffIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no"
                            tools:src="@drawable/ic_power" />

                        <TextView
                            android:id="@+id/activeBuffLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/teal_fill"
                            tools:text="Power Surge" />

                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Actions -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/battle_attack"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_power"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            app:backgroundTint="@color/amber"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDefend"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/battle_defend"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_toughness"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpecial"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/battle_special"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_sparkle"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItems"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/battle_items"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_flask"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/battleLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="@drawable/bg_battle_card_inner"
            android:elevation="4dp"
            android:outlineAmbientShadowColor="@color/shadow_warm"
            android:outlineSpotShadowColor="@color/shadow_warm"
            tools:targetApi="28"
            android:padding="14dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLeave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/battle_leave"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/card_white"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            app:elevation="4dp" />

    </LinearLayout>
</ScrollView>
