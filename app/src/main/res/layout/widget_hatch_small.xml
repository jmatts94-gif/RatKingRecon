<?xml version="1.0" encoding="utf-8"?>
<!-- Narrow and one row high: 2 squares across. Today's steps only, plus the hatch bar. -->
<!-- android:tint, not app:tint: the launcher draws this, not AppCompat. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetHatchRoot"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pill_tan"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <ImageView
            android:id="@+id/widgetStepsNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:tint="@color/text_primary" />

    <ImageView
            android:id="@+id/widgetStepsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:tint="@color/text_muted" />

    <ProgressBar
        android:id="@+id/widgetHatchBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="40"
        android:progressDrawable="@drawable/progress_widget" />
</LinearLayout>
