<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/enlargedLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#993A2A12"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/enlargedCard"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:background="@drawable/bg_recon_card_outer"
        android:padding="5dp"
        android:elevation="10dp">

        <!--
          The Recon Card's own cream-to-tan face and brass frame (see
          ReconCard.kt) - this dialog and that export now read as the same
          object, since both are a single rat held up to look at, just one
          on screen and one composited to a PNG.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_recon_card_inner"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:id="@+id/enlargedRatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:text="Rat Name"
                android:layout_marginBottom="2dp" />

            <!--
              Read from artKey, independently of enlargedRatName above - the
              name field is a display name and nothing guarantees it always
              matches the species (a Spliced Mutant's used to be "Spliced
              Mutant" outright). This line is the one honest answer to "what
              species is this."
            -->
            <TextView
                android:id="@+id/enlargedRatSpecies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:text="Species" />

            <!-- Flavor only, same artKey lookup as the species line above it. -->
            <TextView
                android:id="@+id/enlargedRatFaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:text="Faction"
                android:layout_marginBottom="14dp" />

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_recon_portrait_ring" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/enlargedRatImage"
                    android:layout_width="204dp"
                    android:layout_height="204dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RatKing.Circle"
                    app:strokeColor="@color/card_white"
                    app:strokeWidth="4dp" />

                <!-- Rarity - see bg_recon_stat_pill's sibling bg_badge_scrim
                     comment for why this reads against any art underneath
                     it; bottom|end rather than the grid card's top|start
                     because a circular crop has no readable corner there. -->
                <LinearLayout
                    android:id="@+id/enlargedRatGears"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_badge_scrim"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:id="@+id/enlargedGear1"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/cream"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/enlargedGear2"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/cream"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/enlargedGear3"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="3dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/cream"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_recon_stat_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_power"
                        android:contentDescription="@null"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/enlargedRatPower"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:text="0" />
                </LinearLayout>

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_recon_stat_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_toughness"
                        android:contentDescription="@null"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:id="@+id/enlargedRatToughness"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:text="0" />
                </LinearLayout>
            </LinearLayout>

            <!--
              The faction effects a splice's parents rolled, if any - see
              EnlargedRatDialog. Empty and gone for every ordinary rat; populated
              and shown only for the one-time reveal right after a splice, since
              nothing about which effects fired is saved on the rat itself.
            -->
            <LinearLayout
                android:id="@+id/enlargedEffectsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/battleRatButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/btn_set_battle_rat"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/card_white"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_power"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deployScrapyardButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_deploy_scrap_run"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/amber"
                app:cornerRadius="16dp"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeEnlargedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_close"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/card_white"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp" />

        </LinearLayout>
    </LinearLayout>

    <!--
      A Recon Card export, not a system share of this dialog itself - see
      ReconCard.kt. Pinned to the card's own top-end corner rather than sat
      inside it as a fourth action button, since sharing is a side action on
      the rat, not a peer of Battle Rat / Scrap Run / Close.
    -->
    <ImageButton
        android:id="@+id/enlargedShareButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_alignTop="@id/enlargedCard"
        android:layout_alignEnd="@id/enlargedCard"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="-10dp"
        android:background="@drawable/bg_recon_card_outer"
        android:contentDescription="@string/btn_share"
        android:padding="10dp"
        android:src="@drawable/ic_share"
        android:elevation="12dp"
        app:tint="@color/card_white" />
</RelativeLayout>
