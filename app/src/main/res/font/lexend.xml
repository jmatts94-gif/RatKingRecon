<?xml version="1.0" encoding="utf-8"?>
<!-- Lexend, set once on the theme so every screen gets it. Bold text uses the semibold cut. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/lexend_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/lexend_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/lexend_semibold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/lexend_semibold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
