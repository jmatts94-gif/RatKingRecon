<?xml version="1.0" encoding="utf-8"?>
<!--
  The screen being left behind: fades back without moving.

  Held at partial opacity rather than run to zero, and given no travel of its
  own, so the two screens never both slide at once - the arriving one carries
  the movement and this one just recedes behind it.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_quint"
    android:shareInterpolator="true">

    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.6"
        android:duration="200" />
</set>
