<?xml version="1.0" encoding="utf-8"?>
<!--
  Coming back to the screen underneath, on Back or a close button.

  The mirror of screen_exit: it fades up from where that left it, without
  travel, so returning feels like the top screen lifting off rather than like a
  third screen arriving.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint"
    android:shareInterpolator="true">

    <alpha
        android:fromAlpha="0.6"
        android:toAlpha="1.0"
        android:duration="200" />
</set>
