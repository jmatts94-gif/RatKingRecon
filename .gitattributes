# Normalise line endings so the repo stays LF regardless of who checks it out.
* text=auto eol=lf

# Windows-only scripts need CRLF; the Gradle wrapper script must stay LF or it
# will not run on macOS/Linux.
*.bat text eol=crlf
gradlew text eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.mp3 binary
*.jar binary
